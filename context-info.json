{
  "architecture": {
    "frontend": "React 18 SPA served from dist/public and routed by vercel.json rewrites",
    "backend": "Express server compiled to api/_lib/serverless-app.js and exposed through Vercel functions",
    "database": "Supabase Postgres via DATABASE_URL and Supabase client libraries",
    "realtime": "Supabase Realtime subscriptions in client/src/lib/supabase-realtime.ts",
    "auth": "Firebase Authentication on the client, Firebase Admin on the server",
    "llm": "Mistral and Gemini provider services selected by environment configuration"
  },
  "dependencies": {
    "runtime": "Node.js 22.x",
    "frontend": "React 18, Vite 7, TypeScript",
    "backend": "Express 4, Drizzle ORM, Firebase Admin",
    "database": "Supabase Postgres, Pinecone",
    "ai": "Mistral AI, Gemini API"
  },
  "mainEndpoints": [
    "GET /api/health",
    "GET /api/ecos/scenarios",
    "POST /api/ecos/generate-criteria",
    "POST /api/auth/firebase-login",
    "POST /api/auth/firebase-register",
    "GET /api/teacher/scenarios",
    "GET /api/student/available-scenarios"
  ],
  "criticalFiles": [
    "vercel.json",
    ".env.example",
    "client/src/lib/firebase.ts",
    "client/src/lib/supabase-realtime.ts",
    "server/services/firebase-admin.service.ts",
    "server/services/llm.service.ts",
    "server/services/pinecone.service.ts",
    "api/index.js",
    "api/scenarios.js"
  ],
  "environmentVariables": {
    "environments": [
      "Production",
      "Preview",
      "Development"
    ],
    "providers": [
      "Supabase",
      "Pinecone",
      "Firebase",
      "Mistral",
      "Gemini"
    ],
    "additional": [
      "OpenAI",
      "JWT"
    ],
    "pinecone": {
      "indexName": "n8n-awbg3z6",
      "namespace": "ecos-ceerrf-mistral-gemini-26-05-26",
      "note": "New Pinecone index creation is blocked by the current plan limit of 5 serverless indexes; a dedicated namespace is used instead."
    },
    "deployment": {
      "productionUrl": "https://ecos-ceerrf-mistral-gemini-26-05-26.vercel.app",
      "status": "ready",
      "healthCheck": "healthy"
    }
  }
}
